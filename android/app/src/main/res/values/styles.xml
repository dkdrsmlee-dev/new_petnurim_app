<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OS 다크 모드가 꺼져 있을 때 Android 프로세스 시작 중 적용되는 테마입니다. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Activity에 스플래시 화면을 표시합니다.
             Flutter 엔진이 첫 프레임을 그리면 자동으로 제거됩니다. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- 프로세스 시작 직후 Android Window에 적용되는 테마입니다.
         Flutter UI 초기화 중과 실행 중 UI 뒤쪽 Window 색상을 결정합니다.

         이 테마는 Flutter Android embedding V2부터 사용됩니다. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
